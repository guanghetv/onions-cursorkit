{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AICR Precommit Event",
  "type": "object",
  "required": [
    "event",
    "repo",
    "branch",
    "author",
    "timestamp"
  ],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "cr_invoked",
        "cr_completed",
        "cr_failed",
        "commit_cr_linked",
        "commit_attempted",
        "commit_pushed",
        "commit_without_cr",
        "commit_blocked_without_cr",
        "commit_bypassed_cr",
        "telemetry_error"
      ]
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string"
    },
    "mr_iid": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "cr_completed 须为 pass 或 fail；commit 门禁仅接受 pass"
    },
    "bypass_reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "diff_fingerprint": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
